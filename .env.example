# ============================================
# HungThinh Management - Environment Variables
# ============================================
# Copy this file to .env and replace with your own values
# Command: cp .env.example .env
# WARNING: Do NOT commit .env to git!
# ============================================

# ---------- Database ----------
DB_URL=jdbc:mysql://localhost:3306/your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ---------- JWT ----------
JWT_SECRET=your_jwt_secret_key_base64_encoded
JWT_EXPIRATION=3600000

# ---------- MoMo Payment ----------
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment-result
MOMO_IPN_URL=http://localhost:8081/api/v1/payment/momo-ipn
MOMO_PUBLIC_IPN_URL=
RESIDENT_RETURN_URL=http://localhost:5174/payment-result

# ---------- VNPay Payment ----------
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment-result
VNPAY_RESIDENT_RETURN_URL=http://localhost:5174/payment-result
VNPAY_IPN_URL=http://localhost:8081/api/v1/payment/vnpay-ipn
VNPAY_ALLOW_REQUEST_RETURN_URL=false

# ---------- Gemini AI ----------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
